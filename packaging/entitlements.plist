<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions for the PyInstaller bundle (required for notarization). -->
<plist version="1.0">
<dict>
    <!-- ctypes / libffi (used by pyobjc and the Python runtime) create executable trampolines. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
